generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model User {
  id           Int          @id @default(autoincrement())
  username     String       @unique
  passwordHash String
  fullName     String
  role         String       @default("USER")
  departmentId Int?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  managedDepts Department[] @relation("DeptManager")
  department   Department?  @relation(fields: [departmentId], references: [id])
  roles                 UserRole[]
  dataScope             UserDataScope?
  extraPermissionsJson  String?
  deniedPermissionsJson String?

  // Additional fields
  phone                 String?
  email                 String?         @unique
  employeeCode          String?         @unique
  position              String?
  status                String          @default("ACTIVE") // ACTIVE, LOCKED, INACTIVE, RESIGNED
  mustChangePassword    Boolean         @default(false)
  passwordChangedAt     DateTime?
  failedLoginCount      Int             @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  managerUserId         Int?
  extraDepartmentIds    String?         // JSON array of integers

  managerUser           User?           @relation("UserManager", fields: [managerUserId], references: [id])
  subordinates          User[]          @relation("UserManager")
  discoveredAssets      DiscoveredAsset[]
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  action      String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId    Int
  roleId    Int
  validFrom DateTime?
  validTo   DateTime?
  role      Role      @relation(fields: [roleId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
}

model UserDataScope {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  scopeType         String   @default("SELF") // ALL, COMPANY, DEPARTMENT, WAREHOUSE, PROJECT, SELF, CUSTOM
  companyIdsJson    String?
  departmentIdsJson String?
  warehouseIdsJson  String?
  projectIdsJson    String?
  categoryIdsJson   String?  // Scoping limit by asset categories (JSON array of category IDs/codes)
  user              User     @relation(fields: [userId], references: [id])
}

model RoleDelegation {
  id         Int      @id @default(autoincrement())
  fromUserId Int
  toUserId   Int
  roleId     Int
  validFrom  DateTime
  validTo    DateTime
  isActive   Boolean  @default(true)
  reason     String?
  createdAt  DateTime @default(now())
}

model PermissionRequest {
  id                  Int       @id @default(autoincrement())
  userId              Int
  requestedRoleId     Int?
  requestedPermission String?   // JSON array of specific overriding permission actions
  reason              String
  durationDays        Int?
  status              String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy          String?
  approvedAt          DateTime?
  createdAt           DateTime  @default(now())
}

model Company {
  id           Int          @id @default(autoincrement())
  code         String       @unique
  name         String
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  
  // New fields for professional upgrade
  type         String       @default("COMPANY") // COMPANY, BRANCH, COST_CENTER, SYSTEM
  parentId     Int?
  taxCode      String?
  address      String?
  status       String       @default("ACTIVE") // ACTIVE, HIDDEN, LOCKED, ARCHIVED, MERGED
  mergedIntoId Int?
  note         String?
  createdBy    String       @default("system")

  // Relations
  parent       Company?     @relation("CompanyHierarchy", fields: [parentId], references: [id])
  children     Company[]    @relation("CompanyHierarchy")
  departments  Department[]
}

model Department {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  name        String
  managerId   Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  manager     User?        @relation("DeptManager", fields: [managerId], references: [id])
  users       User[]

  // Additional fields
  type        String       @default("DEPARTMENT") // BOARD, DEPARTMENT, TEAM, PROJECT, WAREHOUSE, OTHER
  companyId   Int?
  parentId    Int?
  description String?
  status      String       @default("ACTIVE") // ACTIVE, INACTIVE

  company     Company?     @relation(fields: [companyId], references: [id])
  parent      Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DeptHierarchy")
}

model Location {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  city      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssetCategory {
  id        Int      @id @default(autoincrement())
  code      String
  name      String
  slug      String?
  level     Int
  parentId  Int?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, code, level])
}

model Asset {
  id                      Int                 @id @default(autoincrement())
  assetCode               String              @unique
  assetName               String
  assetNameShort          String?
  assetNameShortSource    String?             @default("RULE")
  assetNameShortUpdatedAt DateTime?
  serialNumber            String?
  companyCode             String
  companyName             String
  projectName             String?
  level1Code              String
  level1Name              String
  level2Code              String
  level2Name              String
  level3Code              String
  level3Name              String
  level4Code              String
  level4Name              String
  runningNo               Int
  runningNoText           String
  status                  String              @default("IN_STOCK")
  unit                    String?             @default("Cái")
  purchasePriceExVat      Float?              @default(0)
  usagePurpose            String?
  supplierName            String?
  supplierTaxCode         String?
  purchaseDate            DateTime?
  currentUserName         String?
  currentPosition         String?
  departmentName          String?
  locationName            String?
  cityName                String?
  handoverDate            DateTime?
  documentNote            String?
  lastInventoryDate       DateTime?
  lastInventoryStatus     String?
  isDeleted               Boolean             @default(false)
  isLocked                Boolean             @default(false)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  creationBatchId         Int?
  depreciationEndDate     DateTime?
  attachments             String?
  lastLabelPrint          DateTime?
  technicalSpecsJson      String?
  creationBatch           CreationBatch?      @relation(fields: [creationBatchId], references: [id])
  invoiceBatchId          Int?
  invoiceLineId           Int?
  originalInvoiceItemName String?
  invoiceBatch            AssetInvoiceBatch?  @relation(fields: [invoiceBatchId], references: [id])
  invoiceLine             AssetInvoiceLine?   @relation(fields: [invoiceLineId], references: [id])
  assignments             AssetAssignment[]
  editLogs                AssetEditLog[]
  events                  AssetEvent[]
  repairLogs              AssetRepairLog[]
  repairTickets           AssetRepairTicket[]
  damageReports           DamageReportItem[]
  inventoryItems          InventoryItem[]
  liquidations            LiquidationItem[]
  lostReports             LostReport[]
  lostLogs                LostReportLog[]
  histories               AssetHistory[]
}

model CreationBatch {
  id            Int       @id @default(autoincrement())
  batchCode     String    @unique
  batchDate     DateTime  @default(now())
  companyName   String?
  supplierName  String?
  purchaseDate  DateTime?
  documentNo    String?
  totalQuantity Int       @default(0)
  totalValue    Float?    @default(0)
  status        String    @default("COMPLETED")
  note          String?
  createdAt     DateTime  @default(now())
  assets        Asset[]
}

model AssetCodeCounter {
  id          Int      @id @default(autoincrement())
  companyCode String
  level1Code  String
  level2Code  String
  level3Code  String
  level4Code  String
  lastNumber  Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([companyCode, level1Code, level2Code, level3Code, level4Code])
}

model AssetAssignment {
  id                Int      @id @default(autoincrement())
  assetId           Int
  previousUserName  String?
  newUserName       String
  newPosition       String?
  newDepartmentName String?
  newLocationName   String?
  newCityName       String?
  newStatus         String
  effectiveAt       DateTime
  note              String?
  createdAt         DateTime @default(now())
  asset             Asset    @relation(fields: [assetId], references: [id])
}

model InventoryCheck {
  id                 Int             @id @default(autoincrement())
  inventoryCode      String          @unique
  inventoryName      String
  inventoryDate      DateTime
  status             String          @default("DRAFT") // DRAFT, OPEN, IN_PROGRESS, COMPLETED, CANCELLED
  scopeType          String?
  scopeValue         String?
  expectedFinishDate DateTime?
  responsiblePerson  String?
  note               String?
  createdAt          DateTime        @default(now())
  items              InventoryItem[]
  discoveredAssets   DiscoveredAsset[]
}

model InventoryItem {
  id               Int            @id @default(autoincrement())
  inventoryCheckId Int
  assetId          Int
  assetCode        String
  expectedStatus   String?
  actualStatus     String?
  expectedLocation String?
  actualLocation   String?
  quality          String?
  note             String?
  result              String?        // MATCHED, MISSING, EXTRA, DAMAGED, WRONG_LOCATION, NEED_REVIEW
  photos              String[]
  checkStatus         String         @default("PENDING") // PENDING, CHECKED
  checkedAt           DateTime?
  checkedBy           String?
  actualUserName      String?
  actualUserId        Int?
  actualSerialNumber  String?
  checkCondition      String?        @default("FOUND")
  physicalDetailsJson String?
  asset               Asset          @relation(fields: [assetId], references: [id])
  inventoryCheck      InventoryCheck @relation(fields: [inventoryCheckId], references: [id])
}


model AssetEvent {
  id          Int      @id @default(autoincrement())
  assetId     Int
  eventType   String
  eventDate   DateTime @default(now())
  description String?
  performedBy String?
  newStatus   String?
  asset       Asset    @relation(fields: [assetId], references: [id])
}

model AssetEditLog {
  id        Int      @id @default(autoincrement())
  assetId   Int
  fieldName String
  oldValue  String?
  newValue  String?
  editedBy  String?
  createdAt DateTime @default(now())
  asset     Asset    @relation(fields: [assetId], references: [id])
}

model DocumentCounter {
  id           Int    @id @default(autoincrement())
  documentType String @unique
  lastNumber   Int    @default(0)
}

model HandoverDocument {
  id                   Int            @id @default(autoincrement())
  documentNo           String         @unique
  documentDate         DateTime       @default(now())
  type                 String         @default("HANDOVER") // HANDOVER, TRANSFER, RECALL
  status               String         @default("DRAFT")    // DRAFT, PENDING_CONFIRMATION, COMPLETED, CANCELLED
  
  recipientName        String
  recipientPosition    String?
  recipientDepartment  String?
  recipientPhone       String?
  receiverId           Int?
  receiverDepartmentId Int?
  
  senderName           String?
  senderDepartment     String?
  senderPosition       String?
  senderId             Int?
  
  newLocation          String?
  newCity              String?
  targetLocationId     Int?
  
  reason               String?
  note                 String?
  attachments          String?
  
  createdAt            DateTime       @default(now())
  confirmedAt          DateTime?
  cancelledAt          DateTime?
  
  items                HandoverItem[]
}

model HandoverItem {
  id                 Int              @id @default(autoincrement())
  handoverDocumentId Int
  assetId            Int
  assetCode          String
  assetName          String
  unit               String?
  oldStatus          String?
  newStatus          String?
  handoverDocument   HandoverDocument @relation(fields: [handoverDocumentId], references: [id])
}

model DamageReport {
  id              Int                @id @default(autoincrement())
  reportCode      String             @unique
  reportDate      DateTime           @default(now())
  damageLevel     String?
  description     String?
  solution        String?
  repairVendor    String?
  repairCost      Float?             @default(0)
  repairStartDate DateTime?
  repairEndDate   DateTime?
  status          String             @default("DRAFT")
  note            String?
  attachments     String?
  createdAt       DateTime           @default(now())
  items           DamageReportItem[]
}

model DamageReportItem {
  id             Int          @id @default(autoincrement())
  damageReportId Int
  assetId        Int
  asset          Asset        @relation(fields: [assetId], references: [id])
  damageReport   DamageReport @relation(fields: [damageReportId], references: [id])
}

model LostReport {
  id                       Int             @id @default(autoincrement())
  lostCode                 String          @unique
  assetId                  Int
  reportedDate             DateTime        @default(now())
  reportedBy               String?
  lostDetectedDate         DateTime?
  lastSeenDate             DateTime?
  responsibleUser          String?
  responsibleDepartment    String?
  lastKnownLocation        String?
  incidentDescription      String?
  remainingValue           Float?          @default(0)
  compensationNote         String?
  foundDate                DateTime?
  foundLocation            String?
  conditionWhenFound       String?
  newAssetStatusAfterFound String?
  status                   String          @default("LOST")
  note                     String?
  attachments              String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  completedAt              DateTime?
  asset                    Asset           @relation(fields: [assetId], references: [id])
  logs                     LostReportLog[]
}

model LostReportLog {
  id           Int        @id @default(autoincrement())
  lostReportId Int
  assetId      Int
  logDate      DateTime   @default(now())
  action       String
  oldStatus    String?
  newStatus    String?
  description  String?
  performedBy  String
  createdAt    DateTime   @default(now())
  asset        Asset      @relation(fields: [assetId], references: [id])
  lostReport   LostReport @relation(fields: [lostReportId], references: [id])
}

model LiquidationRecord {
  id              Int               @id @default(autoincrement())
  liquidationCode String            @unique
  liquidationDate DateTime          @default(now())
  liquidationType String?
  reason          String?
  buyerName       String?
  documentNo      String?
  totalValue      Float?            @default(0)
  status          String            @default("DRAFT")
  note            String?
  attachments     String?
  createdAt       DateTime          @default(now())
  items           LiquidationItem[]
}

model LiquidationItem {
  id                  Int               @id @default(autoincrement())
  liquidationRecordId Int
  assetId             Int
  assetValue          Float?            @default(0)
  asset               Asset             @relation(fields: [assetId], references: [id])
  liquidationRecord   LiquidationRecord @relation(fields: [liquidationRecordId], references: [id])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  entityType  String
  entityId    Int
  action      String
  details     String?
  performedBy String
  createdAt   DateTime @default(now())
}

model ImportBatch {
  id          Int           @id @default(autoincrement())
  fileName    String
  status      String        @default("PENDING")
  totalRows   Int           @default(0)
  successRows Int           @default(0)
  failedRows  Int           @default(0)
  createdAt   DateTime      @default(now())
  errors      ImportError[]
}

model ImportError {
  id            Int         @id @default(autoincrement())
  importBatchId Int
  rowNumber     Int
  errorMessage  String
  rowData       String?
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id])
}

model AssetRepairTicket {
  id                 Int              @id @default(autoincrement())
  repairCode         String           @unique
  assetId            Int
  reportedDate       DateTime         @default(now())
  reportedBy         String
  damageLevel        String?
  damageDescription  String
  cause              String?
  canContinueUsing   Boolean          @default(true)
  repairAction       String?
  repairVendor       String?
  responsiblePerson  String?
  estimatedCost      Float?           @default(0)
  actualCost         Float?           @default(0)
  sentToRepairDate   DateTime?
  expectedFinishDate DateTime?
  actualFinishDate   DateTime?
  result             String?
  status             String           @default("OPEN")
  previousAssetStatus String?
  note               String?
  attachments        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  logs               AssetRepairLog[]
  asset              Asset            @relation(fields: [assetId], references: [id])
}

model AssetRepairLog {
  id             Int               @id @default(autoincrement())
  repairTicketId Int
  assetId        Int
  logDate        DateTime          @default(now())
  action         String
  oldStatus      String?
  newStatus      String?
  description    String?
  cost           Float?            @default(0)
  performedBy    String
  createdAt      DateTime          @default(now())
  asset          Asset             @relation(fields: [assetId], references: [id])
  repairTicket   AssetRepairTicket @relation(fields: [repairTicketId], references: [id])
}

model DocumentTemplate {
  id             Int                 @id @default(autoincrement())
  templateCode   String              @unique
  templateName   String
  businessModule String
  description    String?
  isRequired     Boolean             @default(true)
  generatePdf    Boolean             @default(true)
  filePath       String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  generatedDocs  GeneratedDocument[]
}

model GeneratedDocument {
  id           String            @id @default(cuid())
  documentNo   String            @unique
  templateCode String?
  documentType String            @default("GENERAL")
  entityType   String?
  entityId     Int?
  fileName     String?
  fileUrl      String?
  fileSize     Int?
  status       String            @default("DRAFT")
  note         String?
  createdById  Int?
  createdBy    String?
  createdAt    DateTime          @default(now())
  template     DocumentTemplate? @relation(fields: [templateId], references: [id])
  templateId   Int?
}

model AssetInvoiceBatch {
  id              Int                @id @default(autoincrement())
  invoiceNo       String
  invoiceDate     DateTime
  supplierId      Int?
  supplierName    String
  supplierTaxCode String?
  companyId       Int
  warehouseId     Int?
  totalAmount     Float?
  fileUrl         String?
  status          String             @default("DRAFT") // DRAFT | VALIDATED | POSTED | CANCELLED
  totalLines      Int                @default(0)
  totalAssets     Int                @default(0)
  totalValue      Float              @default(0)
  createdById     Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  postedAt        DateTime?
  lines           AssetInvoiceLine[]
  assets          Asset[]
}

model AssetInvoiceLine {
  id                 Int               @id @default(autoincrement())
  batchId            Int
  lineNo             Int
  invoiceItemName    String
  assetName          String
  categoryLevel1Id   Int
  categoryLevel2Id   Int
  categoryLevel3Id   Int
  categoryLevel4Id   Int
  quantity           Int
  unitPrice          Float
  amount             Float
  serialsJson        String?           // For serials list (serialized JSON array)
  supplierName       String?
  note               String?
  validationStatus   String            @default("VALID") // VALID | WARNING | ERROR
  warningsJson       String?           // Array of warning/error messages
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  batch              AssetInvoiceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  assets             Asset[]
}

model AssetHistory {
  id                  Int      @id @default(autoincrement())
  assetId             Int
  assetCode           String
  eventTime           DateTime
  source              String   @default("SYSTEM") // SYSTEM, IMPORT_EXCEL_HISTORY
  actionType          String   @default("STATUS_LOCATION_USER_CHANGE") // STATUS_LOCATION_USER_CHANGE, IMPORT_HISTORY
  
  oldStatus           String?
  newStatus           String?
  
  oldUserName         String?
  newUserName         String?
  
  oldLocationName     String?
  newLocationName     String?
  
  oldDepartmentName   String?
  newDepartmentName   String?
  
  oldProjectName      String?
  newProjectName      String?
  
  oldCityName         String?
  newCityName         String?
  
  oldNote             String?
  newNote             String?
  
  assetNameSnapshot   String?
  rawImportJson       String?   // JSON representation of raw row data
  
  importedById        Int?
  importedAt          DateTime? @default(now())

  asset               Asset    @relation(fields: [assetId], references: [id])
}

model Template {
  id           Int               @id @default(autoincrement())
  code         String            @unique
  name         String
  module       String            // e.g. HANDOVER_NEW_ASSET, HANDOVER, TRANSFER, REPAIR, LIQUIDATION, LOSS, INVENTORY, RECALL
  documentType String            @default("PDF") // PDF, HTML
  version      String            @default("v1")
  status       String            @default("ACTIVE") // ACTIVE | DRAFT | INACTIVE
  isDefault    Boolean           @default(false)
  configJson   String            // Stringified JSON configuration
  createdById  Int?
  updatedById  Int?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  versions     TemplateVersion[]
  usages       TemplateUsageLog[]
}

model TemplateVersion {
  id          Int      @id @default(autoincrement())
  templateId  Int
  version     String
  configJson  String
  changeNote  String?
  createdById Int?
  createdAt   DateTime @default(now())
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model TemplateUsageLog {
  id         Int      @id @default(autoincrement())
  templateId Int
  documentId String?
  documentNo String?
  usedById   Int?
  usedAt     DateTime @default(now())
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model DiscoveredAsset {
  id                Int            @id @default(autoincrement())
  tempCode          String         @unique
  name              String
  categoryName      String?
  serialNumber      String?
  foundLocationName String?
  foundUserName     String?
  ownershipStatus   String         @default("UNKNOWN") // COMPANY, PERSONAL, CUSTOMER, VENDOR, RENTAL, UNKNOWN
  photos            String[]
  note              String?
  status            String         @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED, MERGED
  inventoryCheckId  Int
  createdById       Int
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  inventoryCheck    InventoryCheck @relation(fields: [inventoryCheckId], references: [id])
  createdBy         User           @relation(fields: [createdById], references: [id])
}

model ToolEquipment {
  id               Int                    @id @default(autoincrement())
  toolCode         String                 @unique
  toolName         String
  category         String                 // Nhóm CCDC (Bàn ghế, thiết bị văn phòng, vật dụng hỗ trợ...)
  quantity         Int                    @default(1)
  unit             String?                @default("Cái")
  purchasePrice    Float?                 @default(0)
  purchaseDate     DateTime?
  supplierName     String?
  currentUserName  String?
  departmentName   String?
  locationName     String?
  cityName         String?
  projectName      String?
  status           String                 @default("IN_STOCK") // IN_STOCK, USING, DAMAGED, LOST, WAITING_LIQUIDATION, LIQUIDATED
  handoverDate     DateTime?
  note             String?
  attachments      String?                // JSON string or comma-separated file paths
  initialCondition String?
  industryAttributesJson String?       // JSON string containing custom industry attributes
  isDeleted        Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  
  assignments      ToolAssignment[]
  repairTickets    ToolRepairTicket[]
  damageReports    ToolDamageReportItem[]
  inventoryItems   ToolInventoryItem[]
  liquidations     ToolLiquidationItem[]
  lostReports      ToolLostReport[]
  histories        ToolHistory[]
  handoverItems    ToolHandoverItem[]
  repairLogs       ToolRepairLog[]
}

model ToolAssignment {
  id                Int           @id @default(autoincrement())
  toolId            Int
  previousUserName  String?
  newUserName       String
  newPosition       String?
  newDepartmentName String?
  newLocationName   String?
  newCityName       String?
  newStatus         String
  effectiveAt       DateTime
  note              String?
  createdAt         DateTime      @default(now())
  tool              ToolEquipment @relation(fields: [toolId], references: [id])
}

model ToolHandoverDocument {
  id                   Int                  @id @default(autoincrement())
  documentNo           String               @unique
  documentDate         DateTime             @default(now())
  type                 String               @default("HANDOVER") // HANDOVER, TRANSFER, RECALL
  status               String               @default("DRAFT")    // DRAFT, PENDING_CONFIRMATION, COMPLETED, CANCELLED
  recipientName        String
  recipientPosition    String?
  recipientDepartment  String?
  recipientPhone       String?
  receiverId           Int?
  receiverDepartmentId Int?
  senderName           String?
  senderDepartment     String?
  senderPosition       String?
  senderId             Int?
  newLocation          String?
  newCity              String?
  targetLocationId     Int?
  reason               String?
  note                 String?
  attachments          String?
  createdAt            DateTime             @default(now())
  confirmedAt          DateTime?
  cancelledAt          DateTime?
  items                ToolHandoverItem[]
}

model ToolHandoverItem {
  id                   Int                  @id @default(autoincrement())
  handoverDocumentId   Int
  toolId               Int
  toolCode             String
  toolName             String
  unit                 String?
  oldStatus            String?
  newStatus            String?
  handoverDocument     ToolHandoverDocument @relation(fields: [handoverDocumentId], references: [id])
  tool                 ToolEquipment        @relation(fields: [toolId], references: [id])
}

model ToolDamageReport {
  id              Int                    @id @default(autoincrement())
  reportCode      String                 @unique
  reportDate      DateTime               @default(now())
  damageLevel     String?
  description     String?
  solution        String?
  repairVendor    String?
  repairCost      Float?                 @default(0)
  repairStartDate DateTime?
  repairEndDate   DateTime?
  status          String                 @default("DRAFT")
  note            String?
  attachments     String?
  createdAt       DateTime               @default(now())
  items           ToolDamageReportItem[]
}

model ToolDamageReportItem {
  id             Int              @id @default(autoincrement())
  damageReportId Int
  toolId         Int
  tool           ToolEquipment    @relation(fields: [toolId], references: [id])
  damageReport   ToolDamageReport @relation(fields: [damageReportId], references: [id])
}

model ToolLostReport {
  id                       Int           @id @default(autoincrement())
  lostCode                 String        @unique
  toolId                   Int
  reportedDate             DateTime      @default(now())
  reportedBy               String?
  lostDetectedDate         DateTime?
  lastSeenDate             DateTime?
  responsibleUser          String?
  responsibleDepartment    String?
  lastKnownLocation        String?
  incidentDescription      String?
  remainingValue           Float?        @default(0)
  compensationNote         String?
  foundDate                DateTime?
  foundLocation            String?
  conditionWhenFound       String?
  newStatusAfterFound      String?
  status                   String        @default("LOST")
  note                     String?
  attachments              String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  completedAt              DateTime?
  tool                     ToolEquipment @relation(fields: [toolId], references: [id])
}

model ToolLiquidationRecord {
  id              Int                    @id @default(autoincrement())
  liquidationCode String                 @unique
  liquidationDate DateTime               @default(now())
  liquidationType String?
  reason          String?
  buyerName       String?
  documentNo      String?
  totalValue      Float?                 @default(0)
  status          String                 @default("DRAFT")
  note            String?
  attachments     String?
  createdAt       DateTime               @default(now())
  items           ToolLiquidationItem[]
}

model ToolLiquidationItem {
  id                  Int                   @id @default(autoincrement())
  liquidationRecordId Int
  toolId              Int
  toolValue           Float?                @default(0)
  tool                ToolEquipment         @relation(fields: [toolId], references: [id])
  liquidationRecord   ToolLiquidationRecord @relation(fields: [liquidationRecordId], references: [id])
}

model ToolInventoryCheck {
  id                 Int                 @id @default(autoincrement())
  inventoryCode      String              @unique
  inventoryName      String
  inventoryDate      DateTime
  status             String              @default("DRAFT") // DRAFT, OPEN, IN_PROGRESS, COMPLETED, CANCELLED
  scopeType          String?
  scopeValue         String?
  expectedFinishDate DateTime?
  responsiblePerson  String?
  note               String?
  createdAt          DateTime            @default(now())
  items              ToolInventoryItem[]
}

model ToolInventoryItem {
  id                  Int                @id @default(autoincrement())
  inventoryCheckId    Int
  toolId              Int
  toolCode            String
  expectedStatus      String?
  actualStatus        String?
  expectedLocation    String?
  actualLocation      String?
  quality             String?
  note                String?
  result              String?            // MATCHED, MISSING, EXTRA, DAMAGED, WRONG_LOCATION, NEED_REVIEW
  photos              String[]
  checkStatus         String             @default("PENDING") // PENDING, CHECKED
  checkedAt           DateTime?
  checkedBy           String?
  actualUserName      String?
  actualUserId        Int?
  checkCondition      String?            @default("FOUND")
  physicalDetailsJson String?
  tool                ToolEquipment      @relation(fields: [toolId], references: [id])
  inventoryCheck      ToolInventoryCheck @relation(fields: [inventoryCheckId], references: [id])
}

model ToolRepairTicket {
  id                  Int              @id @default(autoincrement())
  repairCode          String           @unique
  toolId              Int
  reportedDate        DateTime         @default(now())
  reportedBy          String
  damageLevel         String?
  damageDescription   String
  cause               String?
  canContinueUsing    Boolean          @default(true)
  repairAction        String?
  repairVendor        String?
  responsiblePerson   String?
  estimatedCost       Float?           @default(0)
  actualCost          Float?           @default(0)
  sentToRepairDate    DateTime?
  expectedFinishDate  DateTime?
  actualFinishDate    DateTime?
  result              String?
  status              String           @default("OPEN")
  previousToolStatus  String?
  note                String?
  attachments         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  logs                ToolRepairLog[]
  tool                ToolEquipment    @relation(fields: [toolId], references: [id])
}

model ToolRepairLog {
  id             Int              @id @default(autoincrement())
  repairTicketId Int
  toolId         Int
  logDate        DateTime         @default(now())
  action         String
  oldStatus      String?
  newStatus      String?
  description    String?
  cost           Float?           @default(0)
  performedBy    String
  createdAt      DateTime         @default(now())
  tool           ToolEquipment    @relation(fields: [toolId], references: [id])
  repairTicket   ToolRepairTicket @relation(fields: [repairTicketId], references: [id])
}

model ToolHistory {
  id                  Int           @id @default(autoincrement())
  toolId              Int
  toolCode            String
  eventTime           DateTime
  source              String        @default("SYSTEM") // SYSTEM, IMPORT_EXCEL_HISTORY
  actionType          String        @default("STATUS_LOCATION_USER_CHANGE")
  oldStatus           String?
  newStatus           String?
  oldUserName         String?
  newUserName         String?
  oldLocationName     String?
  newLocationName     String?
  oldDepartmentName   String?
  newDepartmentName   String?
  oldProjectName      String?
  newProjectName      String?
  oldCityName         String?
  newCityName         String?
  oldNote             String?
  newNote             String?
  toolNameSnapshot    String?
  rawImportJson       String?
  importedById        Int?
  importedAt          DateTime?     @default(now())
  tool                ToolEquipment @relation(fields: [toolId], references: [id])
}




